# Copy to .env and fill in. Vite only exposes variables prefixed with VITE_.
# Production values for the new API (api.glamlink.net). Uploaded files are served
# from the server root, not under /api/v1.
VITE_API_BASE_URL=https://api.glamlink.net/api/v1/
VITE_IMAGE_BASE_URL=https://api.glamlink.net/images/
VITE_VIDEO_BASE_URL=https://api.glamlink.net/videos/

# Third-party keys: a browser key restricted to the panel's domain (admin.glamlink.net)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
