# Copy to .env and fill in. Vite only exposes variables prefixed with VITE_.
VITE_API_BASE_URL=https://your-api-host/api/v1/
VITE_IMAGE_BASE_URL=https://your-api-host/api/v1/images/
VITE_VIDEO_BASE_URL=https://your-api-host/api/v1/videos/

# Third-party keys
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
